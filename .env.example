# Civic Lens — copy to .env (never commit .env)
DB_PATH=/data/civic.db
PORT=8902
# Real domain at deploy (drives canonical + sitemap). Defaults to localhost in dev.
PUBLIC_BASE_URL=http://localhost:8902

# Legistar Web API client slug (Clark County = "clark"). No key required.
LEGISTAR_CLIENT=clark

# Gemma via MLX (OpenAI-compatible). Dev = localhost (MLX runs on this Mac).
# On Arch, point this at the Mac's LAN IP: http://192.168.0.79:8321
MLX_URL=http://127.0.0.1:8321
MLX_MODEL=mlx-community/gemma-4-26b-a4b-it-4bit
